# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS (leave blank to allow localhost:3000 and localhost:5173)
FRONTEND_URL=

# Rate Limiting (prevent abuse)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# API Keys (all optional — free tiers available)

# WHOIS XML API - https://whoisxmlapi.com (500 req/month free)
WHOIS_API_KEY=

# Have I Been Pwned - https://haveibeenpwned.com/API/v3 (non-commercial free)
HIBP_API_KEY=

# AbuseIPDB - https://www.abuseipdb.com/api (1000 req/day free)
ABUSEIPDB_API_KEY=

# OpenCorporates - https://api.opencorporates.com (free tier available)
OPENCORPORATES_API_KEY=
